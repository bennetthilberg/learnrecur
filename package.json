{
  "name": "learnrecur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names next,inngest --prefix-colors blue,magenta \"next dev\" \"inngest dev --no-discovery -u http://localhost:3000/api/inngest\"",
    "dev:app": "next dev",
    "dev:inngest": "inngest dev --no-discovery -u http://localhost:3000/api/inngest",
    "env:check": "tsx scripts/check-production-env.ts --strict",
    "eval:ai-generation": "NODE_OPTIONS='--conditions=react-server' tsx scripts/ai-generation-eval.ts",
    "agent:workos-gate": "tsx scripts/verify-workos-mcp-gate.ts",
    "prebuild": "tsx scripts/check-production-env.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ops": "NODE_OPTIONS='--conditions=react-server' tsx scripts/ops.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:db": "RUN_DATABASE_TESTS=1 vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:db && npm run test:e2e",
    "test:coverage": "vitest run tests/unit --coverage",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@clerk/nextjs": "^7.4.2",
    "@cortex-js/compute-engine": "^0.58.0",
    "@google/genai": "^2.8.0",
    "@mantine/core": "9.2.2",
    "@mantine/hooks": "9.2.2",
    "@mantine/notifications": "^9.2.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@workos-inc/node": "^10.10.0",
    "cheerio": "^1.2.0",
    "inngest": "^4.5.0",
    "jose": "^6.2.8",
    "katex": "^0.17.0",
    "mcp-handler": "^2.1.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.12.4",
    "server-only": "0.0.1",
    "ts-fsrs": "5.4.1",
    "undici": "^7.29.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "inngest-cli": "^1.36.0",
    "postcss": "8.5.26",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "postcss": "8.5.26",
    "protobufjs": "7.6.5",
    "sharp": "0.35.3"
  }
}

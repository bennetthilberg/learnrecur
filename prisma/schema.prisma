generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
}

enum SourceFileKind {
  IMAGE
  PDF
  TEXT
  URL
  OTHER
}

enum SourceFileStatus {
  DRAFT
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum StudyMaterialKind {
  PDF
  WEB
}

enum StudyMaterialStatus {
  ACTIVE
  ARCHIVED
  DELETING
}

enum MaterialRevisionStatus {
  PENDING_UPLOAD
  QUEUED
  PROCESSING
  READY
  FAILED
  DELETING
}

enum MaterialCleanupStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum MaterialPageTextStatus {
  NEEDS_OCR
  OCR_PROCESSING
  OCR_READY
  OCR_FAILED
}

enum SkillDraftBatchStatus {
  PLANNING
  NEEDS_SCOPE
  PLANNED
  GENERATING
  READY
  PARTIAL
  FAILED
  ACTIVATING
  COMPLETE
}

enum SkillDraftBatchItemStatus {
  PLANNED
  GENERATING
  READY
  FAILED
  EXCLUDED
  ACTIVATING
  ACTIVE
}

enum SkillStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SkillGenerationSpecStatus {
  DRAFT
  READY
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum SkillFsrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ExerciseType {
  MULTIPLE_CHOICE
  EXACT_INPUT
}

enum AnswerKind {
  CHOICE
  TEXT
  NUMERIC
  MATH
}

enum ExerciseVerificationStatus {
  DRAFT
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ExerciseAttemptResult {
  CORRECT
  INCORRECT
  SKIPPED
}

enum FsrsRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ExerciseRetirementReason {
  FLAGGED_INCORRECT
  FLAGGED_UNCLEAR
  FLAGGED_UNFAIR
  STALE
  DUPLICATE
  REPLACED
  MANUAL
  OTHER
}

enum ExerciseFlagReason {
  INCORRECT_ANSWER
  UNCLEAR_PROMPT
  UNFAIR
  STALE
  NOT_USEFUL
  OFF_TOPIC
  OTHER
}

enum ExerciseFlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ExerciseFlagAdjudicationStatus {
  PENDING
  CONFIRMED
  REJECTED
  INCONCLUSIVE
}

enum ExerciseEvidenceCorrectionAction {
  NONE
  INVALIDATE
  INVALIDATE_AND_REPLAY
}

enum ExerciseEvidenceCorrectionStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

enum GenerationJobKind {
  SKILL_ACTIVATION
  CHOICE_EXERCISE_GENERATION
  EXACT_INPUT_EXERCISE_GENERATION
  MATH_EXERCISE_GENERATION
}

enum GenerationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum GenerationJobStage {
  QUEUED
  PLANNING
  GENERATING
  VALIDATING
  VERIFYING
  ADJUDICATING
  PUBLISHING
  COMPLETE
  FAILED
}

enum GenerationFailureCategory {
  NONE
  TRANSPORT
  TIMEOUT
  RATE_LIMIT
  AUTHENTICATION
  SCHEMA
  DETERMINISTIC
  SEMANTIC
  SOURCE_EVIDENCE
  DUPLICATE
  DIVERSITY
  COST_LIMIT
  CANCELED
  UNKNOWN
}

enum GenerationDegradedState {
  NONE
  FALLBACK_ACTIVE
  FALLBACK_USED
  QUALITY_REPAIR
  ADJUDICATION_REQUIRED
}

enum GenerationAuditDecision {
  IN_PROGRESS
  RETRY
  ACCEPTED
  REJECTED
  QUARANTINED
  PUBLISHED
  FAILED
}

enum ModelReleaseState {
  DRAFT
  CANARY
  APPROVED
  PAUSED
  ROLLED_BACK
  REJECTED
}

enum ReminderSendStatus {
  PENDING
  SKIPPED
  SENT
  FAILED
}

enum AgentConnectionStatus {
  ACTIVE
  REVOKED
}

enum AgentRemoteRevocationStatus {
  NOT_REQUESTED
  PENDING
  SUCCEEDED
  FAILED
}

enum AgentOperationKind {
  SPEC_BATCH
  TEXT_SOURCE
  MATERIAL_BATCH
  QUICK_FILES
}

enum AgentOperationStatus {
  AWAITING_UPLOAD
  QUEUED
  PLANNING
  NEEDS_INPUT
  NEEDS_REVIEW
  GENERATING
  VERIFYING
  ACTIVATING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELED
}

enum AgentOperationItemStatus {
  QUEUED
  PLANNING
  NEEDS_INPUT
  NEEDS_REVIEW
  GENERATING
  VERIFYING
  ACTIVATING
  ACTIVE
  REUSED
  FAILED
  CANCELED
}

enum AgentCandidateStatus {
  PENDING
  VALIDATED
  VERIFIED
  REJECTED
  NOT_PROCESSED
}

enum AgentRevocationOutboxStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AgentRateLimitKind {
  MUTATION
  READ
}

enum AccountDeletionJobStatus {
  PENDING
  RUNNING
  FAILED
  COMPLETE
}

enum AccountDeletionPhase {
  DISABLE_ACCESS
  DELETE_OBJECTS
  DELETE_RELATIONAL_DATA
  DELETE_CLERK_IDENTITY
  COMPLETE
}

model User {
  id                    String    @id
  email                 String?
  name                  String?
  imageUrl              String?
  lastSeenAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  agentAccessDisabledAt DateTime?

  collections            Collection[]
  sourceFiles            SourceFile[]
  studyMaterials         StudyMaterial[]
  materialRevisions      MaterialRevision[]
  materialSections       MaterialSection[]
  materialChunks         MaterialChunk[]
  materialPages          MaterialPage[]
  materialCleanupJobs    MaterialCleanupJob[]
  skillDraftBatches      SkillDraftBatch[]
  skillDraftBatchItems   SkillDraftBatchItem[]
  skills                 Skill[]
  skillSourceRefs        SkillSourceRef[]
  exercises              Exercise[]
  exerciseAttempts       ExerciseAttempt[]
  reviewLogs             ReviewLog[]
  exerciseFlags          ExerciseFlag[]
  generationJobs         GenerationJob[]
  generationAuditRecords GenerationAuditRecord[]
  reminderPreference     ReminderPreference?
  reminderSendLogs       ReminderSendLog[]
  workosIdentity         WorkosIdentity?
  agentConnections       AgentConnection[]
  agentRateLimitBuckets  AgentRateLimitBucket[]
  agentOperationActions  AgentOperationAction[]
  agentOperationSources  AgentOperationSource[]
  agentOperations        AgentSkillOperation[]
  agentOperationItems    AgentSkillOperationItem[]
  agentCandidates        AgentExerciseCandidate[]

  @@map("users")
}

// This tombstone deliberately has no relation to User. It must survive the
// final relational cascade so object, agent-provider, and Clerk retries still
// have durable state after the app's user-owned records are gone.
model AccountDeletionJob {
  id                          String                   @id @default(cuid())
  userId                      String                   @unique
  status                      AccountDeletionJobStatus @default(PENDING)
  phase                       AccountDeletionPhase     @default(DISABLE_ACCESS)
  manifestVersion             Int                      @default(1)
  manifest                    Json
  objectCount                 Int                      @default(0)
  deletedObjectCount          Int                      @default(0)
  agentConnectionCount        Int                      @default(0)
  revokedAgentConnectionCount Int                      @default(0)
  attemptCount                Int                      @default(0)
  clerkAttemptCount           Int                      @default(0)
  accessDisabledAt            DateTime?
  objectsDeletedAt            DateTime?
  relationalDataDeletedAt     DateTime?
  clerkDeletedAt              DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  lastErrorCode               String?
  lastErrorMessage            String?
  nextAttemptAt               DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@index([status, nextAttemptAt])
  @@index([phase, status])
  @@map("account_deletion_jobs")
}

model Collection {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  status      CollectionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         Skill[]
  sourceFiles    SourceFile[]
  studyMaterials StudyMaterial[]

  @@unique([id, userId])
  @@index([userId, status])
  @@map("collections")
}

model SourceFile {
  id                       String           @id @default(cuid())
  userId                   String
  collectionId             String?
  materialRevisionId       String?
  kind                     SourceFileKind   @default(OTHER)
  status                   SourceFileStatus @default(DRAFT)
  originalName             String
  mimeType                 String?
  byteSize                 Int?
  storageBucket            String?
  storageKey               String?
  presignedUploadExpiresAt DateTime?
  publicUrl                String?
  extractedText            String?
  metadata                 Json?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection       Collection?            @relation(fields: [collectionId, userId], references: [id, userId], onDelete: NoAction)
  materialRevision MaterialRevision?      @relation(fields: [materialRevisionId, userId], references: [id, userId], onDelete: Cascade)
  skillRefs        SkillSourceRef[]
  materialChunks   MaterialChunk[]
  agentOperations  AgentSkillOperation[]
  agentSources     AgentOperationSource[]

  @@unique([id, userId])
  @@unique([id, materialRevisionId, userId])
  @@index([userId, status])
  @@index([userId, presignedUploadExpiresAt])
  @@index([collectionId])
  @@index([materialRevisionId])
  @@map("source_files")
}

model StudyMaterial {
  id                  String              @id @default(cuid())
  userId              String
  collectionId        String?
  title               String
  kind                StudyMaterialKind
  status              StudyMaterialStatus @default(ACTIVE)
  activeRevisionId    String?             @unique
  deletionRequestedAt DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection     Collection?         @relation(fields: [collectionId, userId], references: [id, userId], onDelete: NoAction)
  activeRevision MaterialRevision?   @relation("ActiveMaterialRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  revisions      MaterialRevision[]  @relation("MaterialRevisions")
  cleanupJob     MaterialCleanupJob?

  @@unique([id, userId])
  @@index([userId, status, updatedAt])
  @@index([collectionId])
  @@map("study_materials")
}

model MaterialRevision {
  id                 String                 @id @default(cuid())
  userId             String
  materialId         String
  revisionNumber     Int
  status             MaterialRevisionStatus @default(PENDING_UPLOAD)
  sourceUrl          String?
  contentHash        String?
  byteSize           Int?
  pageCount          Int?
  fetchedPageCount   Int?
  summary            String?                @db.Text
  storageBucket      String?
  storageKey         String?
  processingMetadata Json?
  errorCode          String?
  errorMessage       String?
  finalizedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  material          StudyMaterial         @relation("MaterialRevisions", fields: [materialId, userId], references: [id, userId], onDelete: Cascade)
  activeForMaterial StudyMaterial?        @relation("ActiveMaterialRevision")
  sourceFiles       SourceFile[]
  sections          MaterialSection[]
  chunks            MaterialChunk[]
  pages             MaterialPage[]
  draftBatches      SkillDraftBatch[]
  agentOperations   AgentSkillOperation[]

  @@unique([id, userId])
  @@unique([materialId, revisionNumber])
  @@index([userId, status])
  @@map("material_revisions")
}

model MaterialSection {
  id                 String   @id @default(cuid())
  userId             String
  materialRevisionId String
  parentId           String?
  ordinal            Int
  level              Int      @default(1)
  title              String
  normalizedTitle    String
  pageStart          Int?
  pageEnd            Int?
  url                String?
  anchor             String?
  headingPath        String[]
  metadata           Json?
  createdAt          DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialRevision MaterialRevision  @relation(fields: [materialRevisionId, userId], references: [id, userId], onDelete: Cascade)
  parent           MaterialSection?  @relation("MaterialSectionHierarchy", fields: [parentId, materialRevisionId, userId], references: [id, materialRevisionId, userId], onDelete: NoAction)
  children         MaterialSection[] @relation("MaterialSectionHierarchy")
  chunks           MaterialChunk[]

  @@unique([id, userId])
  @@unique([id, materialRevisionId, userId])
  @@unique([materialRevisionId, ordinal])
  @@index([materialRevisionId, parentId, ordinal])
  @@index([userId])
  @@map("material_sections")
}

model MaterialChunk {
  id                 String                      @id @default(cuid())
  userId             String
  materialRevisionId String
  materialSectionId  String?
  sourceFileId       String?
  ordinal            Int
  text               String
  tokenEstimate      Int
  contentHash        String
  locator            Json
  headingText        String?
  searchText         Unsupported("tsvector")?    @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(\"headingText\", ''::text) || ' '::text) || text))"))
  embedding          Unsupported("vector(768)")?
  createdAt          DateTime                    @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialRevision MaterialRevision @relation(fields: [materialRevisionId, userId], references: [id, userId], onDelete: Cascade)
  materialSection  MaterialSection? @relation(fields: [materialSectionId, materialRevisionId, userId], references: [id, materialRevisionId, userId], onDelete: NoAction)
  sourceFile       SourceFile?      @relation(fields: [sourceFileId, materialRevisionId, userId], references: [id, materialRevisionId, userId], onDelete: NoAction)

  @@unique([id, userId])
  @@unique([materialRevisionId, ordinal])
  @@index([materialRevisionId, materialSectionId, ordinal])
  @@index([userId])
  @@index([searchText], type: Gin)
  @@map("material_chunks")
}

model MaterialPage {
  id                 String                 @id @default(cuid())
  userId             String
  materialRevisionId String
  pageNumber         Int
  embeddedText       String?
  ocrText            String?
  textStatus         MaterialPageTextStatus @default(NEEDS_OCR)
  contentHash        String
  tokenEstimate      Int                    @default(0)
  metadata           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialRevision MaterialRevision @relation(fields: [materialRevisionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([materialRevisionId, pageNumber])
  @@index([userId, textStatus])
  @@map("material_pages")
}

model MaterialCleanupJob {
  id           String                @id @default(cuid())
  userId       String
  materialId   String                @unique
  status       MaterialCleanupStatus @default(PENDING)
  attemptCount Int                   @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  material StudyMaterial @relation(fields: [materialId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([materialId, userId])
  @@index([userId, status])
  @@map("material_cleanup_jobs")
}

model Skill {
  id                             String                      @id @default(cuid())
  userId                         String
  collectionId                   String?
  title                          String
  objective                      String?
  rules                          Json?
  examples                       Json?
  exerciseConstraints            Json?
  tags                           String[]
  generationSpec                 Json?
  generationSpecVersion          String?
  generationSpecFingerprint      String?
  generationSpecStatus           SkillGenerationSpecStatus   @default(DRAFT)
  similarityEmbedding            Unsupported("vector(768)")?
  similarityEmbeddingModel       String?
  similarityEmbeddingFingerprint String?
  status                         SkillStatus                 @default(DRAFT)
  dueAt                          DateTime?
  stability                      Float?
  difficulty                     Float?
  elapsedDays                    Int                         @default(0)
  scheduledDays                  Int                         @default(0)
  learningSteps                  Int                         @default(0)
  repetitions                    Int                         @default(0)
  lapses                         Int                         @default(0)
  fsrsState                      SkillFsrsState              @default(NEW)
  lastReviewedAt                 DateTime?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt

  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection             Collection?               @relation(fields: [collectionId, userId], references: [id, userId], onDelete: NoAction)
  sourceRefs             SkillSourceRef[]
  exercises              Exercise[]
  attempts               ExerciseAttempt[]
  reviewLogs             ReviewLog[]
  generationJobs         GenerationJob[]
  generationAuditRecords GenerationAuditRecord[]
  draftBatchItems        SkillDraftBatchItem[]
  agentCreatedItems      AgentSkillOperationItem[] @relation("AgentCreatedSkill")
  agentResultItems       AgentSkillOperationItem[] @relation("AgentResultSkill")

  @@unique([id, userId])
  @@index([userId, status, dueAt])
  @@index([userId, generationSpecStatus, generationSpecFingerprint], map: "skills_generation_spec_lookup_idx")
  @@index([collectionId])
  @@map("skills")
}

model SkillDraftBatch {
  id                 String                @id @default(cuid())
  userId             String
  materialRevisionId String
  instruction        String
  proposedPlan       Json?
  confirmedPlan      Json?
  planningMetadata   Json?
  status             SkillDraftBatchStatus @default(PLANNING)
  idempotencyKey     String
  requestedCount     Int                   @default(0)
  readyCount         Int                   @default(0)
  failedCount        Int                   @default(0)
  excludedCount      Int                   @default(0)
  activatedCount     Int                   @default(0)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  confirmedAt        DateTime?
  completedAt        DateTime?

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialRevision MaterialRevision      @relation(fields: [materialRevisionId, userId], references: [id, userId], onDelete: Cascade)
  items            SkillDraftBatchItem[]

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([materialRevisionId])
  @@map("skill_draft_batches")
}

model SkillDraftBatchItem {
  id                 String                    @id @default(cuid())
  userId             String
  batchId            String
  skillId            String?
  ordinal            Int
  targetKey          String
  proposedTitle      String
  proposedObjective  String
  locator            Json
  status             SkillDraftBatchItemStatus @default(PLANNED)
  overlapSkillId     String?
  errorCode          String?
  errorMessage       String?
  generationAttempts Int                       @default(0)
  generationMetadata Json?
  generationClaimId  String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch SkillDraftBatch @relation(fields: [batchId, userId], references: [id, userId], onDelete: Cascade)
  skill Skill?          @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([id, userId])
  @@unique([batchId, ordinal])
  @@unique([batchId, targetKey])
  @@index([userId, status])
  @@index([skillId])
  @@map("skill_draft_batch_items")
}

model SkillSourceRef {
  id           String   @id @default(cuid())
  userId       String
  skillId      String
  sourceFileId String
  locator      Json?
  note         String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)
  sourceFile SourceFile @relation(fields: [sourceFileId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([skillId, sourceFileId])
  @@index([userId])
  @@index([sourceFileId])
  @@map("skill_source_refs")
}

model Exercise {
  id                   String                     @id @default(cuid())
  userId               String
  skillId              String
  type                 ExerciseType
  answerKind           AnswerKind
  prompt               String
  choices              Json?
  answerSpec           Json
  correctAnswerDisplay String
  explanation          String?
  difficulty           Int?
  expectedSeconds      Int?
  verificationStatus   ExerciseVerificationStatus @default(UNVERIFIED)
  retiredAt            DateTime?
  retirementReason     ExerciseRetirementReason?
  freshnessKey         String?
  sourceRefs           Json?
  skillSpecVersion     String?
  skillSpecFingerprint String?
  exerciseSpecVersion  String?
  blueprintVersion     String?
  blueprintSlot        String?
  exerciseFamily       String?
  qualityVersion       String?
  provenance           Json?
  acceptanceDecision   GenerationAuditDecision?
  acceptanceMetadata   Json?
  generationMetadata   Json?
  generatorReleaseId   String?
  verifierReleaseId    String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill            Skill                   @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)
  attempts         ExerciseAttempt[]
  flags            ExerciseFlag[]
  agentCandidate   AgentExerciseCandidate?
  auditRecords     GenerationAuditRecord[]
  generatorRelease ModelRelease?           @relation("ExerciseGeneratorRelease", fields: [generatorReleaseId], references: [id], onDelete: SetNull)
  verifierRelease  ModelRelease?           @relation("ExerciseVerifierRelease", fields: [verifierReleaseId], references: [id], onDelete: SetNull)

  @@unique([id, userId])
  @@unique([id, skillId, userId])
  @@index([userId, createdAt])
  @@index([skillId, verificationStatus])
  @@index([skillId, verificationStatus, retiredAt])
  @@index([skillId, skillSpecFingerprint])
  @@index([exerciseFamily, qualityVersion])
  @@map("exercises")
}

model ExerciseAttempt {
  id               String                @id @default(cuid())
  userId           String
  skillId          String
  exerciseId       String
  answer           Json
  normalizedAnswer String?
  isCorrect        Boolean
  result           ExerciseAttemptResult
  responseMs       Int?
  proposedRating   FsrsRating?
  finalRating      FsrsRating?
  feedbackShownAt  DateTime?
  createdAt        DateTime              @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill      @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)
  exercise  Exercise   @relation(fields: [exerciseId, skillId, userId], references: [id, skillId, userId], onDelete: Cascade)
  reviewLog ReviewLog?

  @@unique([id, userId])
  @@unique([id, skillId, userId])
  @@index([userId, createdAt])
  @@index([skillId, createdAt])
  @@index([exerciseId])
  @@map("exercise_attempts")
}

model ReviewLog {
  id                    String          @id @default(cuid())
  userId                String
  skillId               String
  exerciseAttemptId     String          @unique
  finalRating           FsrsRating
  reviewedAt            DateTime        @default(now())
  previousDueAt         DateTime?
  nextDueAt             DateTime?
  previousStability     Float?
  nextStability         Float?
  previousDifficulty    Float?
  nextDifficulty        Float?
  previousElapsedDays   Int?
  nextElapsedDays       Int?
  previousScheduledDays Int?
  nextScheduledDays     Int?
  previousLearningSteps Int?
  nextLearningSteps     Int?
  previousRepetitions   Int?
  nextRepetitions       Int?
  previousLapses        Int?
  nextLapses            Int?
  previousState         SkillFsrsState?
  nextState             SkillFsrsState?
  schedulerName         String
  schedulerVersion      String
  desiredRetention      Float
  schedulerParameters   Json
  createdAt             DateTime        @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill           Skill           @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)
  exerciseAttempt ExerciseAttempt @relation(fields: [exerciseAttemptId, skillId, userId], references: [id, skillId, userId], onDelete: Cascade)

  @@unique([exerciseAttemptId, skillId, userId])
  @@index([userId, reviewedAt])
  @@index([skillId, reviewedAt])
  @@map("review_logs")
}

model ExerciseFlag {
  id                              String                           @id @default(cuid())
  userId                          String
  exerciseId                      String
  reason                          ExerciseFlagReason
  note                            String?
  status                          ExerciseFlagStatus               @default(OPEN)
  resolvedAt                      DateTime?
  resolutionNote                  String?
  retiredExerciseAt               DateTime?
  retirementReason                ExerciseRetirementReason?
  adjudicationStatus              ExerciseFlagAdjudicationStatus   @default(PENDING)
  adjudicatedAt                   DateTime?
  adjudicationCode                String?
  evidenceCorrectionAction        ExerciseEvidenceCorrectionAction @default(NONE)
  evidenceCorrectionStatus        ExerciseEvidenceCorrectionStatus @default(NOT_REQUIRED)
  practiceEvidenceNeedsCorrection Boolean                          @default(false)
  affectedReviewCount             Int                              @default(0)
  correctionStartedAt             DateTime?
  correctionCompletedAt           DateTime?
  incidentKey                     String?
  createdAt                       DateTime                         @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([exerciseId, status])
  @@index([adjudicationStatus, evidenceCorrectionStatus])
  @@index([incidentKey])
  @@map("exercise_flags")
}

model GenerationJob {
  id                  String                    @id @default(cuid())
  userId              String
  skillId             String
  kind                GenerationJobKind
  status              GenerationJobStatus       @default(PENDING)
  provider            String
  model               String
  promptVersion       String
  idempotencyKey      String?
  releaseTuple        Json?
  generationReleaseId String?
  verifierReleaseId   String?
  stage               GenerationJobStage        @default(QUEUED)
  checkpoint          String?
  attemptCount        Int                       @default(0)
  retryCount          Int                       @default(0)
  maxAttempts         Int                       @default(3)
  contextManifest     Json?
  contextManifestHash String?
  stageMetrics        Json?
  failureCategory     GenerationFailureCategory @default(NONE)
  degradedState       GenerationDegradedState   @default(NONE)
  fallbackProvider    String?
  fallbackModel       String?
  fallbackReasonCode  String?
  requestedCount      Int
  acceptedCount       Int                       @default(0)
  rejectedCount       Int                       @default(0)
  errorMessage        String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill             Skill                   @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)
  auditRecords      GenerationAuditRecord[]
  generationRelease ModelRelease?           @relation("GenerationJobGenerationRelease", fields: [generationReleaseId], references: [id], onDelete: SetNull)
  verifierRelease   ModelRelease?           @relation("GenerationJobVerifierRelease", fields: [verifierReleaseId], references: [id], onDelete: SetNull)

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([skillId, status])
  @@index([userId, stage, status])
  @@index([failureCategory, createdAt])
  @@index([degradedState, createdAt])
  @@map("generation_jobs")
}

model ModelRelease {
  id                  String            @id @default(cuid())
  provider            String
  model               String
  releaseFingerprint  String
  state               ModelReleaseState @default(DRAFT)
  releaseTuple        Json
  canaryPercent       Int               @default(0)
  canarySampleCount   Int               @default(0)
  canaryAcceptedCount Int               @default(0)
  canaryRejectedCount Int               @default(0)
  canaryStopReason    String?
  canaryMetrics       Json?
  rollbackToId        String?
  approvedAt          DateTime?
  canaryStartedAt     DateTime?
  pausedAt            DateTime?
  rolledBackAt        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  rollbackTo             ModelRelease?           @relation("ModelReleaseRollback", fields: [rollbackToId], references: [id], onDelete: SetNull)
  rollbackSources        ModelRelease[]          @relation("ModelReleaseRollback")
  generationJobs         GenerationJob[]         @relation("GenerationJobGenerationRelease")
  verifierJobs           GenerationJob[]         @relation("GenerationJobVerifierRelease")
  generatedExercises     Exercise[]              @relation("ExerciseGeneratorRelease")
  verifiedExercises      Exercise[]              @relation("ExerciseVerifierRelease")
  generationAuditRecords GenerationAuditRecord[] @relation("AuditGenerationRelease")
  verifierAuditRecords   GenerationAuditRecord[] @relation("AuditVerifierRelease")

  @@unique([provider, model, releaseFingerprint])
  @@index([provider, model, state])
  @@index([state, updatedAt])
  @@map("model_releases")
}

// This row is append-only while its owning learner/job exists. Skill, exercise,
// job, and account deletion intentionally cascade to satisfy learner-data
// deletion; application code never rewrites a surviving audit decision.
model GenerationAuditRecord {
  id                  String                    @id @default(cuid())
  userId              String
  jobId               String
  skillId             String?
  candidateId         String?
  exerciseId          String?
  idempotencyKey      String
  eventKey            String
  stage               GenerationJobStage
  checkpoint          String?
  attempt             Int
  retryCount          Int                       @default(0)
  releaseTuple        Json
  contextManifest     Json?
  contextManifestHash String?
  stageMetrics        Json?
  candidateMetadata   Json?
  failureCategory     GenerationFailureCategory @default(NONE)
  degradedState       GenerationDegradedState   @default(NONE)
  decision            GenerationAuditDecision   @default(IN_PROGRESS)
  generationReleaseId String?
  verifierReleaseId   String?
  createdAt           DateTime                  @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job               GenerationJob @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  skill             Skill?        @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)
  exercise          Exercise?     @relation(fields: [exerciseId, userId], references: [id, userId], onDelete: Cascade)
  generationRelease ModelRelease? @relation("AuditGenerationRelease", fields: [generationReleaseId], references: [id], onDelete: SetNull)
  verifierRelease   ModelRelease? @relation("AuditVerifierRelease", fields: [verifierReleaseId], references: [id], onDelete: SetNull)

  @@unique([jobId, eventKey])
  @@index([userId, createdAt])
  @@index([jobId, stage, createdAt])
  @@index([idempotencyKey])
  @@index([decision, createdAt])
  @@map("generation_audit_records")
}

model ReminderPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  enabled         Boolean  @default(false)
  email           String
  localHour       Int      @default(9)
  timezone        String   @default("America/New_York")
  minimumDueCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, localHour])
  @@map("reminder_preferences")
}

model ReminderSendLog {
  id                String             @id @default(cuid())
  userId            String
  localDate         String
  status            ReminderSendStatus
  dueCount          Int
  email             String?
  provider          String?
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([status, createdAt])
  @@map("reminder_send_logs")
}

model WorkosIdentity {
  id           String   @id @default(cuid())
  userId       String   @unique
  workosUserId String   @unique
  externalId   String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections AgentConnection[]

  @@unique([id, userId])
  @@map("workos_identities")
}

model AgentConnection {
  id                     String                      @id @default(cuid())
  userId                 String
  workosIdentityId       String
  workosSubject          String
  workosSessionId        String                      @unique
  workosApplicationId    String
  clientId               String
  clientName             String
  clientDomain           String
  resourceUrl            String
  scopes                 String[]
  permissionVersion      Int                         @default(1)
  status                 AgentConnectionStatus       @default(ACTIVE)
  remoteRevocationStatus AgentRemoteRevocationStatus @default(NOT_REQUESTED)
  connectedAt            DateTime                    @default(now())
  lastUsedAt             DateTime?
  revokedAt              DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workosIdentity   WorkosIdentity         @relation(fields: [workosIdentityId, userId], references: [id, userId], onDelete: Cascade)
  operations       AgentSkillOperation[]
  operationActions AgentOperationAction[]
  rateLimitBuckets AgentRateLimitBucket[]

  @@unique([id, userId])
  @@index([userId, status, connectedAt])
  @@index([workosSubject, clientId, resourceUrl])
  @@map("agent_connections")
}

model AgentSkillOperation {
  id                 String               @id @default(cuid())
  userId             String
  connectionId       String
  kind               AgentOperationKind
  toolName           String
  status             AgentOperationStatus @default(QUEUED)
  idempotencyKey     String
  payloadHash        String
  requestPayload     Json?
  payloadExpiresAt   DateTime?
  sourceFileId       String?
  materialRevisionId String?
  requestedCount     Int                  @default(0)
  activeCount        Int                  @default(0)
  reusedCount        Int                  @default(0)
  failedCount        Int                  @default(0)
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       AgentConnection           @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Cascade)
  sourceFile       SourceFile?               @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  materialRevision MaterialRevision?         @relation(fields: [materialRevisionId], references: [id], onDelete: SetNull)
  items            AgentSkillOperationItem[]
  actions          AgentOperationAction[]
  sources          AgentOperationSource[]

  @@unique([id, userId])
  @@unique([connectionId, toolName, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([connectionId, createdAt])
  @@map("agent_skill_operations")
}

model AgentOperationAction {
  id             String   @id @default(cuid())
  userId         String
  connectionId   String
  operationId    String
  toolName       String
  idempotencyKey String
  payloadHash    String
  createdAt      DateTime @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection AgentConnection     @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Cascade)
  operation  AgentSkillOperation @relation(fields: [operationId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([connectionId, toolName, idempotencyKey])
  @@index([operationId, createdAt])
  @@map("agent_operation_actions")
}

model AgentOperationSource {
  id           String @id @default(cuid())
  userId       String
  operationId  String
  sourceFileId String
  ordinal      Int

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation  AgentSkillOperation @relation(fields: [operationId, userId], references: [id, userId], onDelete: Cascade)
  sourceFile SourceFile          @relation(fields: [sourceFileId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([operationId, sourceFileId])
  @@unique([operationId, ordinal])
  @@index([sourceFileId])
  @@map("agent_operation_sources")
}

model AgentSkillOperationItem {
  id                          String                   @id @default(cuid())
  userId                      String
  operationId                 String
  ordinal                     Int
  clientReference             String
  status                      AgentOperationItemStatus @default(QUEUED)
  proposedTitle               String?
  proposedObjective           String?
  skillSnapshot               Json?
  candidateFingerprint        String?
  duplicateLibraryFingerprint String?
  duplicateConfidence         String?
  duplicateOverrideApprovedAt DateTime?
  createdSkillId              String?                  @unique
  resultSkillId               String?
  errorCode                   String?
  errorMessage                String?
  retryCount                  Int                      @default(0)
  activationReservedAt        DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation    AgentSkillOperation      @relation(fields: [operationId, userId], references: [id, userId], onDelete: Cascade)
  createdSkill Skill?                   @relation("AgentCreatedSkill", fields: [createdSkillId], references: [id], onDelete: SetNull)
  resultSkill  Skill?                   @relation("AgentResultSkill", fields: [resultSkillId], references: [id], onDelete: SetNull)
  candidates   AgentExerciseCandidate[]

  @@unique([id, userId])
  @@unique([operationId, ordinal])
  @@unique([operationId, clientReference])
  @@index([userId, status, createdAt])
  @@index([resultSkillId])
  @@map("agent_skill_operation_items")
}

model AgentExerciseCandidate {
  id                String               @id @default(cuid())
  userId            String
  operationItemId   String
  ordinal           Int
  clientReference   String?
  kind              AnswerKind
  normalizedPayload Json
  status            AgentCandidateStatus @default(PENDING)
  verifierReason    String?
  verifierNote      String?
  exerciseId        String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationItem AgentSkillOperationItem @relation(fields: [operationItemId, userId], references: [id, userId], onDelete: Cascade)
  exercise      Exercise?               @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([id, userId])
  @@unique([operationItemId, ordinal])
  @@index([userId, status, createdAt])
  @@map("agent_exercise_candidates")
}

model AgentRevocationOutbox {
  id            String                      @id @default(cuid())
  userId        String
  connectionId  String
  workosUserId  String
  applicationId String
  status        AgentRevocationOutboxStatus @default(PENDING)
  attemptCount  Int                         @default(0)
  errorCode     String?
  nextAttemptAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@unique([id, userId])
  @@unique([connectionId])
  @@index([status, nextAttemptAt])
  @@map("agent_revocation_outbox")
}

model AgentRateLimitBucket {
  id           String             @id @default(cuid())
  userId       String
  connectionId String
  kind         AgentRateLimitKind
  windowStart  DateTime
  count        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection AgentConnection @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([connectionId, kind, windowStart])
  @@index([userId, windowStart])
  @@map("agent_rate_limit_buckets")
}

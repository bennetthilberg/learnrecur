[Unit]
Description=Back up LearnRecur to private object storage
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=learnrecur
Group=learnrecur
WorkingDirectory=/srv/learnrecur/repo
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/learnrecur/backup-venv/bin/python -m learnrecur.deploy.scheduled_backup --config /srv/learnrecur/backup.json run
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/learnrecur
